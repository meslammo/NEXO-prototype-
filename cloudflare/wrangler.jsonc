{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "nexo-prototype",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORS_ORIGINS": "*",
    "LEGACY_API_ORIGIN": "https://nexo-api-production-05d3.up.railway.app",
    "NATIVE_CORE": "0",
    "NATIVE_REALTIME": "0",
    "NATIVE_GAMES": "0",
    "PAYMENTS_READY": "0",
    "PBKDF2_ITERATIONS": "60000"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "NexoGameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NexoGameRoom"] }
  ]
}
