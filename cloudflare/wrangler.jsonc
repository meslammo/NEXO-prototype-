{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "nexo-api-adapter",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORS_ORIGINS": "*",
    "LEGACY_API_ORIGIN": "https://nexo-online-control.hatchable.site"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexo",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "NexoGameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NexoGameRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "nexo-assets"
    }
  ]
}
